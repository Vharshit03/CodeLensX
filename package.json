{
  "name": "codelensx",
  "displayName": "CodeLensX",
  "description": "AI-powered code review and optimization",
  "version": "0.0.1",
  "icon": "images/icon3.png",
  "publisher": "Harshitvas1004",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vharshit03/CodeLensX"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "CodeLensX",
          "title": "CodeLensX",
          "icon": "resources/icon4.svg"
        }
      ]
    },
    "views": {
      "CodeLensX": [
        {
          "type": "webview",
          "id": "CodeLensX.settingsView",
          "name": "",
          "icon": "resources/icon4.svg",
          "contextualTitle": "CodeLensX "
        }
      ]
    },
    "commands": [
      {
        "command": "CodeLensX.reviewWorkspace",
        "title": "Review Workspace"
      },
      {
        "command": "CodeLensX.reviewFile",
        "title": "Review Current File"
      },
      {
        "command": "CodeLensX.showReport",
         "title": "CodeLensX: Open Saved Report"
      },
      {
        "command": "CodeLensX.cancelReview",
         "title": "CodeLensX: Cancels Review"
      },
      {
        "command": "CodeLensX.openSettings",
        "title": "Open Settings",
        "category": "AI Code Reviewer"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "dotenv": "^17.2.3"
  }
}
